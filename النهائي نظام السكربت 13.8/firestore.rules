rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared application configuration across all users
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Shared scenario reports history
    match /reports/{reportId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection health check
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
